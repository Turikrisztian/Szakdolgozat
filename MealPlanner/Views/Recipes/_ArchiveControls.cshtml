@model MealPlanner.Models.Recipe

@{
    var currentUserId = User.FindFirst(
        System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

    var canManageRecipe =
        User.Identity?.IsAuthenticated == true &&
        (
            Model.UserId == currentUserId ||
            User.IsInRole(MealPlanner.Security.AppRoles.Admin)
        );
}

@if (canManageRecipe)
{
    <div class="mb-4">
        @if (Model.IsArchived)
        {
            <div class="alert alert-warning">
                Ez a recept archiválva van.
                A nyilvános receptlistában nem jelenik meg.
            </div>

            <form asp-controller="Recipes"
                  asp-action="Restore"
                  asp-route-id="@Model.Id"
                  method="post">

                <button type="submit"
                        class="btn btn-success">
                    Recept visszaállítása
                </button>
            </form>

            <div class="form-text">
                Visszaállítás után a nyilvánosnak jelölt recept
                ismét megjelenik a nyilvános listában.
            </div>
        }
        else
        {
            <form asp-controller="Recipes"
                  asp-action="Archive"
                  asp-route-id="@Model.Id"
                  method="post">

                <button type="submit"
                        class="btn btn-outline-warning">
                    Recept archiválása
                </button>
            </form>

            <div class="form-text">
                Az archivált recept megmarad a saját receptek között,
                és később visszaállítható.
            </div>
        }
    </div>
}