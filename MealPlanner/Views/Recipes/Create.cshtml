@model MealPlanner.ViewModels.Recipes.RecipeCreateViewModel

@{
    ViewData["Title"] = "Új recept";
}

<h1>@ViewData["Title"]</h1>

@if (Model.CategoryOptions.Count == 0 ||
     Model.IngredientOptions.Count == 0 ||
     Model.UnitOptions.Count == 0)
{
    <div class="alert alert-warning" role="alert">
        A receptfelvitelhez aktív kategóriára, aktív alapanyagra
        és mértékegységre is szükség van.
        A hiányzó adatokat az adminisztrátornak kell előkészítenie.
    </div>
}

<form asp-action="Create" method="post">
    <div asp-validation-summary="All"
         class="text-danger mb-3"></div>

    <div class="row">
        <div class="col-md-8 mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title"
                   class="form-control"
                   maxlength="200" />
            <span asp-validation-for="Title"
                  class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId"
                    asp-items="Model.CategoryOptions"
                    class="form-select">
                <option value="">Válassz kategóriát</option>
            </select>
            <span asp-validation-for="CategoryId"
                  class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Servings" class="form-label"></label>
            <input asp-for="Servings"
                   class="form-control"
                   min="1"
                   step="1" />
            <span asp-validation-for="Servings"
                  class="text-danger"></span>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="PreparationTimeMinutes"
                   class="form-label"></label>
            <input asp-for="PreparationTimeMinutes"
                   class="form-control"
                   min="1"
                   step="1" />
            <span asp-validation-for="PreparationTimeMinutes"
                  class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Instructions" class="form-label"></label>
        <textarea asp-for="Instructions"
                  class="form-control"
                  rows="7"
                  maxlength="10000"></textarea>
        <span asp-validation-for="Instructions"
              class="text-danger"></span>
    </div>

    <div class="form-check mb-4">
        <input asp-for="IsPublic" class="form-check-input" />
        <label asp-for="IsPublic" class="form-check-label"></label>
        <div class="form-text">
            Ha bejelölöd, a receptet mások bejelentkezés nélkül is láthatják.
        </div>
    </div>

    <h2 class="h4">Hozzávalók</h2>

    <p class="text-muted">
        A mennyiségeket a fent megadott teljes adagszámhoz add meg.
        Tizedes mennyiségnél vesszőt vagy pontot is használhatsz,
        például 0,5 vagy 0.5.
    </p>

    @for (var i = 0; i < Model.Ingredients.Count; i++)
    {
        <fieldset class="border rounded p-3 mb-3">
            <legend class="float-none w-auto px-2 fs-6">
                @(i + 1). hozzávaló
            </legend>

            <div class="row">
                <div class="col-md-5 mb-3">
                    <label asp-for="Ingredients[i].IngredientId"
                           class="form-label"></label>
                    <select asp-for="Ingredients[i].IngredientId"
                            asp-items="Model.IngredientOptions"
                            class="form-select">
                        <option value="">Válassz alapanyagot</option>
                    </select>
                    <span asp-validation-for="Ingredients[i].IngredientId"
                          class="text-danger"></span>
                </div>

                <div class="col-md-3 mb-3">
                    <label asp-for="Ingredients[i].Quantity"
                           class="form-label"></label>
                    <input asp-for="Ingredients[i].Quantity"
                           type="text"
                           inputmode="decimal"
                           maxlength="19"
                           class="form-control" />
                    <span asp-validation-for="Ingredients[i].Quantity"
                          class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Ingredients[i].UnitId"
                           class="form-label"></label>
                    <select asp-for="Ingredients[i].UnitId"
                            asp-items="Model.UnitOptions"
                            class="form-select">
                        <option value="">Válassz mértékegységet</option>
                    </select>
                    <span asp-validation-for="Ingredients[i].UnitId"
                          class="text-danger"></span>
                </div>
            </div>

            <button type="submit"
                    name="operation"
                    value="remove:@i"
                    formnovalidate
                    class="btn btn-sm btn-outline-danger">
                Hozzávaló eltávolítása
            </button>
        </fieldset>
    }

    <div class="mb-4">
        <button type="submit"
                name="operation"
                value="add"
                formnovalidate
                class="btn btn-outline-primary">
            Új hozzávalósor
        </button>
    </div>

    <div class="mb-4">
        <button type="submit"
                name="operation"
                value="save"
                class="btn btn-primary">
            Recept mentése
        </button>

        <a asp-action="Mine"
           class="btn btn-outline-secondary">
            Mégse
        </a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}