@model MealPlanner.ViewModels.MealPlans.MealPlanWeekViewModel

@using MealPlanner.ViewModels.MealPlans
@using MealPlanner.Models.Enums
@using System.Globalization

@{
    ViewData["Title"] = "Heti étkezéstervező";
    var hu = CultureInfo.GetCultureInfo("hu-HU");
}

<h1>@ViewData["Title"]</h1>

<p class="text-muted">
    Tervezd meg, melyik nap mit eszel,
    és hány adagra lesz szükséged.
</p>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="status">
        @success
    </div>
}

@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">
        @error
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h4 mb-3">
            @Model.WeekStart.ToString("yyyy. MM. dd.")
            –
            @Model.WeekEnd.ToString("yyyy. MM. dd.")
        </h2>

        <div class="d-flex flex-wrap gap-2 mb-3">
            @if (Model.PreviousWeek is DateOnly previous)
            {
                <a asp-action="Index"
                   asp-route-weekStart="@MealPlanCalendar.Iso(previous)"
                   class="btn btn-outline-secondary">
                    Előző hét
                </a>
            }

            <a asp-action="Index"
               class="btn btn-outline-primary">
                Aktuális hét
            </a>

            @if (Model.NextWeek is DateOnly next)
            {
                <a asp-action="Index"
                   asp-route-weekStart="@MealPlanCalendar.Iso(next)"
                   class="btn btn-outline-secondary">
                    Következő hét
                </a>
            }
        </div>

        <form asp-action="Index"
              method="get"
              class="row g-2 align-items-end">

            <div class="col-sm-auto">
                <label for="weekStart" class="form-label">
                    Válassz egy napot a kívánt héten
                </label>

                <input id="weekStart"
                       name="weekStart"
                       type="date"
                       class="form-control"
                       value="@MealPlanCalendar.Iso(Model.WeekStart)"
                       required />
            </div>

            <div class="col-sm-auto">
                <button type="submit" class="btn btn-primary">
                    Hét megnyitása
                </button>
            </div>
        </form>
    </div>
</div>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">
        Erre a hétre még nincs tervezett étkezésed.
        A Hozzáadás gombbal válassz receptet.
    </div>
}

<div class="row g-3">
    @for (var dayIndex = 0; dayIndex < 7; dayIndex++)
    {
        var date = Model.WeekStart.AddDays(dayIndex);

        <div class="col-12 col-md-6 col-xl-4">
            <section class="card h-100"
                     aria-labelledby="day-@dayIndex">

                <div class="card-header">
                    <h2 class="h5 mb-0" id="day-@dayIndex">
                        @hu.TextInfo.ToTitleCase(date.ToString("dddd", hu))
                    </h2>

                    <span class="text-muted">
                        @date.ToString("yyyy. MM. dd.")
                    </span>
                </div>

                <div class="card-body">
                    @foreach (var mealType in Enum.GetValues<MealType>())
                    {
                        var entries = Model.Items
                            .Where(item =>
                                item.Date == date &&
                                item.MealType == mealType)
                            .ToList();

                        <div class="mb-3 pb-2 border-bottom">
                            <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-2">
                                <h3 class="h6 mb-0">
                                    @MealPlanCalendar.MealName(mealType)
                                </h3>

                                <a asp-action="Create"
                                   asp-route-date="@MealPlanCalendar.Iso(date)"
                                   asp-route-mealType="@((int)mealType)"
                                   class="btn btn-sm btn-outline-primary"
                                   aria-label="@($"{date:yyyy. MM. dd.} – {MealPlanCalendar.MealName(mealType)}: recept hozzáadása")">
                                    Hozzáadás
                                </a>
                            </div>

                            @if (entries.Count == 0)
                            {
                                <p class="small text-muted mb-2">
                                    Még nincs recept.
                                </p>
                            }

                            @foreach (var item in entries)
                            {
                                <div class="mb-3">
                                    @if (item.CanViewRecipe)
                                    {
                                        <a asp-area=""
                                           asp-controller="Recipes"
                                           asp-action="Details"
                                           asp-route-id="@item.RecipeId"
                                           class="fw-semibold text-break">
                                            @item.RecipeTitle
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            @item.RecipeTitle
                                        </span>
                                    }

                                    @if (item.IsArchived)
                                    {
                                        <span class="badge bg-secondary">
                                            Archivált
                                        </span>
                                    }

                                    <div class="small mb-2">
                                        @item.Servings adag
                                    </div>

                                    <div class="d-flex flex-wrap gap-2">
                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            Szerkesztés
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Eltávolítás
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </section>
        </div>
    }
</div>