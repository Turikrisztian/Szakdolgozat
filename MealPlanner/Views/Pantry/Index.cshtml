@using System.Globalization
@model IReadOnlyList<MealPlanner.Models.PantryItem>

@{
    ViewData["Title"] = "Saját készlet";
    var hungarianCulture = CultureInfo.GetCultureInfo("hu-HU");
}

<h1>@ViewData["Title"]</h1>

<p class="text-muted">
    Tartsd nyilván, milyen alapanyagokból mennyi van otthon.
</p>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">
        @successMessage
    </div>
}

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        Alapanyag felvétele
    </a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        A készleted még üres. Az „Alapanyag felvétele” gombbal
        rögzítheted az otthon rendelkezésre álló alapanyagokat.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th scope="col">Alapanyag</th>
                    <th scope="col" class="text-end">Mennyiség</th>
                    <th scope="col">Mértékegység</th>
                    <th scope="col">Állapot</th>
                    <th scope="col">Műveletek</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @item.Ingredient.Name

                            @if (!item.Ingredient.IsActive)
                            {
                                <span class="badge bg-secondary ms-2">
                                    Inaktív alapanyag
                                </span>
                            }
                        </td>

                        <td class="text-end">
                            @item.Quantity.ToString("0.###", hungarianCulture)
                        </td>

                        <td>
                            @item.Unit.Name (@item.Unit.Symbol)
                        </td>

                        <td>
                            @if (item.Quantity == 0)
                            {
                                <span class="badge bg-warning text-dark">
                                    Elfogyott
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    Van készleten
                                </span>
                            }
                        </td>

                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Szerkesztés
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger">
                                    Törlés
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}