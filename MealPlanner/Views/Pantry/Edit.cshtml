@model MealPlanner.ViewModels.Pantry.PantryEditViewModel

@{
    ViewData["Title"] = "Készlettétel szerkesztése";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Edit"
              asp-route-id="@Model.Id"
              method="post">

            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <div class="form-label">Alapanyag</div>

                <p class="form-control-plaintext fw-semibold">
                    @Model.IngredientName
                </p>
            </div>

            <div class="mb-3">
                <label asp-for="Quantity"
                       class="form-label"></label>

                <input asp-for="Quantity"
                       type="text"
                       inputmode="decimal"
                       class="form-control"
                       placeholder="Például: 250 vagy 0,5" />

                <span asp-validation-for="Quantity"
                      class="text-danger"></span>

                <div class="form-text">
                    A teljes, jelenleg rendelkezésre álló mennyiséget add meg.
                    Ha az alapanyag elfogyott, írj nullát.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="UnitId"
                       class="form-label"></label>

                <select asp-for="UnitId"
                        asp-items="Model.UnitOptions"
                        class="form-select">
                    <option value="">-- Válassz mértékegységet --</option>
                </select>

                <span asp-validation-for="UnitId"
                      class="text-danger"></span>
            </div>

            <div class="alert alert-info">
                Mértékegységváltáskor a mennyiséget is írd át.
                Például 500 milliliter helyett 0,5 litert adj meg.
            </div>

            <button type="submit" class="btn btn-primary">
                Mentés
            </button>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Mégse
            </a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}