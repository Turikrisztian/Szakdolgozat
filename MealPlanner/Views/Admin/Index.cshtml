@{
    ViewData["Title"] = "Adminisztráció";
}

<h1>Adminisztráció</h1>

<p>
    Ezt az oldalt kizárólag adminisztrátori szerepkörrel
    rendelkező felhasználók érhetik el.
</p>

<p>
    Itt lesznek elérhetők a kategóriák és az alapanyagok
    kezelésére szolgáló funkciók.
</p>
<div class="mt-4">
    <a asp-controller="Categories"
       asp-action="Index"
       class="btn btn-primary">
        Kategóriák kezelése
    </a>
    <a asp-controller="Ingredients"
       asp-action="Index"
       class="btn btn-primary">
        Alapanyagok kezelése
    </a>
</div>